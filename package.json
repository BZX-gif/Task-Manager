{
  "name": "voicebill",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VoiceBill — voice-first billing for Indian kirana shops. Speak. Review. Bill.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test \"tests/unit/*.test.ts\"",
    "test:integration": "node scripts/build-tests.mjs && node --test \"tests/.tmp/*.test.js\"",
    "test:all": "npm run test && npm run test:integration",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:integration"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  }
}
