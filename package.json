{
  "name": "command-center",
  "type": "module",
  "scripts": {
    "dev": "npm run build:client:dev && vite",
    "build": "npm run build:client && vite build",
    "build:client": "node scripts/build-client.mjs",
    "build:client:dev": "node scripts/build-client.mjs --dev",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "verify": "npm run lint && npm run typecheck && npm test",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:integration": "npm run build && node --test \"tests/integration/*.test.js\""
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.23",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@types/node": "^22.20.2",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
