{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-manager",
  "main": "./dist/index.js",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": ["GEMINI_API_KEY"]
  },
  "assets": {
    "directory": "./dist"
  }
}
